# The server listens on all interfaces so a phone on the same Wi-Fi can reach it.
PORT=8787
HOST=0.0.0.0
# Set this to the laptop's LAN address before installing the miniapp, for example:
# PUBLIC_BASE_URL=http://192.168.1.42:8787
PUBLIC_BASE_URL=

# Keep the upstream bearer token on the laptop. Never put it in the miniapp.
# OpenAI-compatible service root; the server appends /v1/chat/completions.
AI_BASE_URL=http://localhost:11434
AI_BEARER_TOKEN=
AI_MODEL=qwen3.8-27b
# Qwen requests disable reasoning by default to keep the inspection response
# short and predictable. Set true only when the configured provider supports it.
AI_ENABLE_THINKING=false
AI_TIMEOUT_MS=90000
# Completion budget for the structured inspection result.
AI_EVALUATION_MAX_TOKENS=2000
# Resize AI inputs only; the original evidence remains unchanged.
AI_IMAGE_MAX_EDGE=640
AI_IMAGE_JPEG_QUALITY=80
