{
  "name": "mentra-inspection-v0",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Glasses-first field inspection miniapp and local companion server for MentraOS",
  "engines": {
    "node": ">=20",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "setup": "bun install && node scripts/install.mjs",
    "dev": "node scripts/dev.mjs",
    "server": "node scripts/run-app.mjs server dev",
    "miniapp": "node scripts/run-app.mjs miniapp dev",
    "build": "node scripts/run-app.mjs miniapp build",
    "release": "node scripts/run-app.mjs miniapp release",
    "preview": "node scripts/preview.mjs",
    "lint": "biome lint . --error-on-warnings",
    "lint:fix": "biome lint . --write",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "check": "biome check . --error-on-warnings"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13"
  }
}
